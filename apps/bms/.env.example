# apps/bms — environment

# Data source. Leave BOTH unset to run entirely on the deterministic mock spine (the
# default; the app needs no backend). Set INSURIMPLE_API_URL to point the party / policy /
# renewal reads at the live Insurimple-ARS backend instead.
#
#   INSURIMPLE_API_URL=http://localhost:4000
#   INSURIMPLE_TENANT_ID=tenant-klc   # sent as x-tenant-id; defaults to tenant-klc
